---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/sections/Header.astro';
import Footer from '../components/sections/Footer.astro';
import StickyCta from '../components/sections/StickyCta.astro';
import Hero from '../components/sections/Hero.astro';
import Doors from '../components/sections/Doors.astro';
import Services from '../components/sections/Services.astro';
import Results from '../components/sections/Results.astro';
import Process from '../components/sections/Process.astro';
import Journal from '../components/sections/Journal.astro';
import Reviews from '../components/sections/Reviews.astro';
import Clients from '../components/sections/Clients.astro';
import Contact from '../components/sections/Contact.astro';
import contact from '../../content/contact/index.json';
import journal from '../../content/journal/index.json';

const showJournal = (journal.handle ?? '').trim().replace(/^@+/, '').trim() !== '';
const allLinks = [
  { label: 'Servicii', href: '#servicii' },
  { label: 'Rezultate', href: '#rezultate' },
  { label: 'Jurnal', href: '#jurnal' },
  { label: 'Contact', href: '#contact' },
];
const links = showJournal ? allLinks : allLinks.filter((l) => l.href !== '#jurnal');
---
<BaseLayout>
  <Header slot="header" links={links} />
  <Hero />
  <Doors />
  <Clients />
  <Services />
  <Results />
  <Process />
  <Journal />
  <Reviews />
  <Contact />
  <Footer slot="footer" />
  <StickyCta slot="after" href={contact.telegramHref} />
</BaseLayout>
