---
import '@fontsource/gloock/latin-400.css';
import '@fontsource/gloock/latin-ext-400.css';
import '@fontsource-variable/hanken-grotesk/wght.css';
import '@fontsource/caveat/latin-500.css';
import '@fontsource/caveat/latin-ext-500.css';
import '@fontsource/caveat/latin-700.css';
import '@fontsource/caveat/latin-ext-700.css';
import '../styles/global.css';
import { isPreview } from '../lib/env';

const preview = isPreview(import.meta.env);

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Irina SMM | Expert Social Media Management', description } = Astro.props;
---
<html lang="ro">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}img/logo.png`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}img/logo.png`} />
    {preview && <meta name="robots" content="noindex, nofollow" />}
    {!preview && <script defer src="https://cloud.umami.is/script.js" data-website-id="a85b5ab8-f53a-4b79-8569-df4a92e6b148"></script>}
  </head>
  <script>
    // Fallback for browsers without scroll-driven animations; content stays visible if this never runs.
    if (
      !CSS.supports('animation-timeline: view()') &&
      'IntersectionObserver' in window &&
      matchMedia('(prefers-reduced-motion: no-preference)').matches
    ) {
      document.documentElement.classList.add('reveal-io');
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
        });
      }, { threshold: 0.1 });
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    }
  </script>
  <body>
    <a href="#main" class="skip-link">Sari la conținut</a>
    <slot name="header" />
    <main id="main">
      <slot />
    </main>
    <slot name="footer" />
    <slot name="after" />
  </body>
</html>