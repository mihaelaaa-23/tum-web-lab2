---
import processData from '../../../content/process/index.json';
import Tape from '../primitives/Tape.astro';

interface Props {
  data?: typeof processData;
}
const { data = processData } = Astro.props;
const { headline, steps } = data;
---
<section id="proces" class="section scroll-mt-20 bg-cream" aria-labelledby="process-heading">
  <div class="mx-auto max-w-[1100px] px-4">
    <h2 id="process-heading" class="mb-10 text-center text-ink md:mb-14">{headline}</h2>
    <ol class="m-0 grid list-none gap-8 p-0 lg:grid-cols-4 lg:gap-10">
      {steps.map((s: any, i: number) => (
        <li class="relative">
          <span class="mb-2 block font-display text-5xl leading-none text-teal" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="mb-2 font-display text-2xl tracking-[-0.02em] text-ink">{s.title}</h3>
          <p class="m-0 text-ink-muted">{s.text}</p>
          {i < steps.length - 1 && (
            <div class="hidden lg:block">
              <Tape color={i % 2 ? 'blush' : 'teal'} class="-right-9 top-6 rotate-[-4deg]" />
            </div>
          )}
        </li>
      ))}
    </ol>
  </div>
</section>
