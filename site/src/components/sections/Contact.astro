---
import contactData from '../../../content/contact/index.json';

interface Props {
  data?: typeof contactData;
}
const { data = contactData } = Astro.props;
const { headline, subtext, email, telegramHref, telegramLabel, instagramHref } = data;
const btn = 'inline-flex min-h-12 items-center justify-center rounded-[10px] px-6 font-semibold';
---
<section id="contact" class="section bg-cream" aria-labelledby="contact-heading">
  <div class="mx-auto max-w-[700px] px-4 text-center">
    <h2 id="contact-heading" class="reveal mb-4 text-ink">{headline}</h2>
    <p class="mb-8 text-ink-muted">{subtext}</p>
    <div class="flex flex-col items-stretch gap-3 sm:flex-row sm:flex-wrap sm:justify-center">
      <a href={telegramHref} target="_blank" rel="noopener" class:list={[btn, 'bg-teal text-cream']}>{telegramLabel}</a>
      <a href={instagramHref} target="_blank" rel="noopener" class:list={[btn, 'border-2 border-teal text-teal']}>Scrie-mi pe Instagram</a>
      <a href={`mailto:${email}`} class:list={[btn, 'border-2 border-teal text-teal']}>Scrie-mi pe email</a>
    </div>
  </div>
</section>
