---
import { manifest, srcsetFor } from '../../lib/images';

interface Props {
  src: string;
  alt: string;
  sizes?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  class?: string;
}

const { src, alt, sizes = '100vw', loading = 'lazy', fetchpriority, class: className } = Astro.props;
const entry = manifest[src];
const avif = srcsetFor(src, 'avif');
const webp = srcsetFor(src, 'webp');
---
{entry && avif && webp ? (
  <picture>
    <source type="image/avif" srcset={avif} sizes={sizes} />
    <source type="image/webp" srcset={webp} sizes={sizes} />
    <img src={src} alt={alt} width={entry.width} height={entry.height} loading={loading} decoding="async" fetchpriority={fetchpriority} class={className} />
  </picture>
) : (
  <img src={src} alt={alt} loading={loading} decoding="async" fetchpriority={fetchpriority} class={className} />
)}
