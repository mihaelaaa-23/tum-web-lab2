---
interface Props {
  size?: number;
  class?: string;
}
const { size = 140, class: className = '' } = Astro.props;
const spots =
  'radial-gradient(circle at 30% 30%, var(--color-leopard-spot) 6px, transparent 7px), ' +
  'radial-gradient(circle at 70% 60%, var(--color-leopard-spot) 5px, transparent 6px), ' +
  'radial-gradient(circle at 50% 80%, var(--color-leopard-spot) 4px, transparent 5px)';
---
<span
  aria-hidden="true"
  class:list={['pointer-events-none block rounded-full bg-leopard-tan', className]}
  style={`width:${size}px;height:${size}px;background-image:${spots};background-size:34px 34px`}></span>
